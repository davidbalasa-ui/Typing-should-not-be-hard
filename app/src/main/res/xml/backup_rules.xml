<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <include
        domain="root"
        path="jetpref_datastore"/>
    <include
        domain="file"
        path="ime"/>
    <!-- TypeBetter: My fixes, Never change and their weekly copies. Only into an end-to-end encrypted
         backup (Android 9 and later read requireFlags; Android 12+ uses data_extraction_rules.xml). -->
    <include
        domain="file"
        path="typebetter"
        requireFlags="clientSideEncryption"/>
    <include
        domain="database"
        path="floris_user_dictionary"/>
    <!-- The saved prompts, as data_extraction_rules.xml explains. -->
    <include
        domain="database"
        path="prompts.db"/>
</full-backup-content>
